{
  "name": "avatarweave",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/renderer",
    "packages/react",
    "apps/demo",
    "apps/speaking"
  ],
  "scripts": {
    "dev": "npm run dev -w @avatarweave/demo",
    "dev:speaking": "npm run dev -w @avatarweave/speaking",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "node --test tests/*.test.mjs",
    "pack:libs": "npm pack -w @avatarweave/core -w @avatarweave/renderer -w @avatarweave/react",
    "check": "npm run build && npm run typecheck && npm test"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "gh-pages": "^6.3.0"
  }
}
