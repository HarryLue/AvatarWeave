# SQLite is the default. Paths are resolved from the project root.
# DATABASE_URL=sqlite+aiosqlite:////absolute/path/avatar.db
# DATABASE_URL=postgresql+asyncpg://avatar:avatar@127.0.0.1:5433/avatar
LIVEKIT_URL=ws://127.0.0.1:17880
# Leave empty to follow Nginx's current domain, port, and HTTP/HTTPS scheme.
# Set only when the browser must connect to a separate signaling endpoint.
# Use wss://your-domain/realtime when HTTPS is configured.
RTC_PUBLIC_URL=
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=avatar-kit-local-development-secret-2026
AGENT_NAME=avatar-assistant
ALLOWED_AGENTS=avatar-assistant
# mock: real LiveKit text transport, deterministic replies, no model credentials
# Real providers are configured independently in config/pipeline.yaml.
# Set PIPELINE_MODE=pipeline (or remove this override) for real voice.
PIPELINE_MODE=mock
OPENAI_API_KEY=
LLM_MODEL=gpt-4.1-mini
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=coral
# Optional for local demo. Required for externally exposed token service.
API_ACCESS_KEY=
# Optional standalone server executable; otherwise uses `livekit-server` on PATH.
LIVEKIT_BINARY=

# Optional override; otherwise use config/pipeline.yaml's profile
# PIPELINE_PROFILE=huoshan
# LLM_BASE_URL=https://api.openai.com/v1
# ASR_BASE_URL=https://api.openai.com/v1
# TTS_BASE_URL=https://api.openai.com/v1
VOLC_APP_KEY=
VOLC_ACCESS_KEY=
VOLC_APP_ID=
VOLC_ACCESS_TOKEN=
VOLC_TTS_VOICE=zh_female_qingxinnvsheng_mars_bigtts
DASHSCOPE_API_KEY=
ALI_TTS_VOICE=longfeifei_v3
CARTESIA_API_KEY=
CARTESIA_VOICE=
DEEPGRAM_API_KEY=
ELEVEN_API_KEY=
GOOGLE_API_KEY=

# Optional proxy for LiveKit worker + realtime ASR (also accepts standard proxy env vars)
# AGENT_HTTP_PROXY=http://127.0.0.1:7890

# Local inference: CPU/GPU is independent from voice/session capabilities.
KOKORO_BASE_URL=http://127.0.0.1:8880/v1
KOKORO_VOICE=zf_xiaoxiao
KOKORO_PRECISION=fp32
# cpu or gpu; GPU dependencies are installed by deploy.sh
KOKORO_DEVICE=cpu
KOKORO_GPU_ID=0
# Optional directory of existing CUDA/cuDNN .so files; no runtime libraries are downloaded.
# KOKORO_CUDA_LIB_DIR=/path/to/existing/lib
KOKORO_THREADS=4

# Application configuration and bounded history context
AVATAR_CONFIG=config/avatars.yaml
VOICE_CONFIG=config/voices.yaml
AGENT_HISTORY_LIMIT=100
# Enable the selected profile's TTS preview in text-only mock mode
MOCK_TTS_PREVIEW=false
# false when using an independently managed/remote Kokoro endpoint
KOKORO_MANAGED=true

